<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    xmlns:plone="http://namespaces.plone.org/plone"
    i18n_domain="link.checker"
    >

  <!-- Set overrides folder for Just-a-Bunch-Of-Templates product -->
  <include
      package="z3c.jbot"
      file="meta.zcml"
      />
  <browser:jbot
      directory="overrides"
      layer="link.checker.interfaces.IBrowserLayer"
      />

  <!-- Publish static files -->
  <plone:static
      directory="static"
      name="link.checker"
      type="plone"
      />
  <browser:page
      name="link-checker"
      for="zope.interface.Interface"
      class=".linkchecker.LinkCheckerView"
      permission="collective.linkchecker.Run"
      template="linkchecker.pt"
      />

  <browser:page
      name="link-checker-export"
      for="zope.interface.Interface"
      class=".linkchecker.LinkCheckerExport"
      permission="collective.linkchecker.Run"
      />

  <browser:page
      name="link-checker-text"
      for="zope.interface.Interface"
      class=".textlinkchecker.TextLinkCheckerView"
      permission="collective.linkchecker.Run"
      template="textlinkchecker.pt"
      />

  <browser:page
      name="link-checker-text-export"
      for="zope.interface.Interface"
      class=".textlinkchecker.TextLinkCheckerExport"
      permission="collective.linkchecker.Run"
      />
</configure>
